# --- Database ---
# For local dev you need a real Postgres instance now (the schema targets
# Postgres so it matches what Render provisions). Easiest options:
#   1. Run one in Docker:  docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=devpass postgres:16
#      then: DATABASE_URL="postgresql://postgres:devpass@localhost:5432/postgres"
#   2. Or just point this at your Render database's EXTERNAL connection
#      string (Render dashboard -> your Postgres -> "External Database URL")
#      and develop directly against the hosted DB.
DATABASE_URL=

# --- OpenCaselist / Tabroom auth ---
# A real Tabroom account that is linked/authorized on opencaselist.com
# (log in at opencaselist.com once by hand to confirm it works, then use
# the same username/password here)
TABROOM_USERNAME=
TABROOM_PASSWORD=

# --- Tabroom scraping ---
TABROOM_BASE_URL=https://staging.tabroom.com
# Set to your own contact info - identify yourself, don't pretend to be a browser
SCRAPER_USER_AGENT="debate-catalog-bot/0.1 (contact: you@example.com)"
# Milliseconds to wait between requests - be a good citizen, this is a free community site
SCRAPER_DELAY_MS=1500
